# Copy to backend/.env and fill in. Never commit .env.

# development (default) or production (enforces the production checks below)
ENVIRONMENT=development

# LLM provider: anthropic | google | openai | ollama
LLM_PROVIDER=anthropic
LLM_API_KEY=
# Empty = provider default (anthropic: claude-opus-5, google: gemini-2.5-flash, ollama: qwen3.5:4b)
LLM_MODEL=
# Optional:
# LLM_BASE_URL=
# LLM_MAX_TOKENS=
# LLM_EFFORT=medium            # low | medium | high | xhigh | max
# LLM_THINKING=true            # anthropic, google: stream reasoning summaries
# LLM_REFUSAL_FALLBACK=true    # anthropic: server-side refusal fallbacks

# Local models via Ollama (see local-llm/README.md)
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# LLM_CONTEXT_WINDOW=32768

# Server. Loopback by default. To serve other machines, run behind a TLS
# proxy, bind to 0.0.0.0 and list the public host name in ALLOWED_HOSTS.
HOST=127.0.0.1
PORT=8787
LOG_LEVEL=INFO
LOG_JSON=false
# ALLOWED_HOSTS=["localhost","127.0.0.1","[::1]"]
# FORWARDED_ALLOW_IPS=127.0.0.1   # proxies trusted for X-Forwarded-For

# Restrict the API to your extension's ID (see chrome://extensions).
# Empty = any chrome-extension:// origin (development only).
ALLOWED_EXTENSION_IDS=[]

# Storage. Empty DATABASE_URL = a SQLite file in DATA_DIR (development).
# Production: postgresql+asyncpg://user:password@host:5432/browser_agent
# DATA_DIR=./data
# DATABASE_URL=
# DATABASE_AUTO_MIGRATE=true
# Redis for sign-in sessions, task locks and rate limits. Empty = in this
# process only (one instance; sign-ins end when the server restarts).
# REDIS_URL=redis://127.0.0.1:6379/0
# Comma-separated Fernet keys; the first encrypts, all decrypt (rotation).
# Empty in development = generated into DATA_DIR/encryption.key.
# Generate: uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# DATA_ENCRYPTION_KEYS=
# TASK_RETENTION_DAYS=0            # delete finished tasks after N days (0 = keep)

# Accounts. The first account can always be created from the extension.
# ALLOW_REGISTRATION=false
# SESSION_TTL_HOURS=720

# Rate limits
# RATE_LIMIT_LOGINS_PER_15M=10
# RATE_LIMIT_TASKS_PER_MINUTE=20
# RATE_LIMIT_REQUESTS_PER_MINUTE=300
# MAX_RUNNING_TASKS_PER_USER=3

# Sites the agent may use (a domain covers its subdomains).
# ALLOWED_DOMAINS=[]               # empty = all sites except BLOCKED_DOMAINS
# BLOCKED_DOMAINS=["mybank.com"]
# Tool risk levels that always need your approval: read | interact | high_impact.
# Buying, sending, deleting etc. are always put to you regardless.
# CONFIRM_RISK_LEVELS=["high_impact"]
# CONFIRMATION_TIMEOUT_SECONDS=300

AGENT_MAX_STEPS=25
TOOL_TIMEOUT_SECONDS=30
# USER_REPLY_TIMEOUT_SECONDS=900
# Caps on page text / page-map size per tool call (lower them for small local models)
AGENT_PAGE_TEXT_LIMIT=40000
AGENT_ELEMENT_LIMIT=150
