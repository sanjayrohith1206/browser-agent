# Settings for docker compose (see docker-compose.yml and backend/.env.example).
# Copy to .env.production. Never commit the copy.
POSTGRES_PASSWORD=
LLM_PROVIDER=anthropic
LLM_API_KEY=
# Your extension's ID from chrome://extensions.
ALLOWED_EXTENSION_IDS=["your-extension-id"]
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
DATA_ENCRYPTION_KEYS=
# The host name your proxy serves the API on.
ALLOWED_HOSTS=["agent.example.com"]
# The proxy's address inside the Docker network (or * if only the proxy can reach it).
FORWARDED_ALLOW_IPS=*
TASK_RETENTION_DAYS=90
